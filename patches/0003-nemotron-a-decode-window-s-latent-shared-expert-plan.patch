     const R: usize = pass_rows;
@@ -118,7 +123,7 @@ fn scratchSizes(c: Config, nch: usize) [scratch_count]usize {
         (if (lat) latent.routerSlices(D) else 6) * R * c.experts * 4, pairs * own * 4,                                R * ns * 4,

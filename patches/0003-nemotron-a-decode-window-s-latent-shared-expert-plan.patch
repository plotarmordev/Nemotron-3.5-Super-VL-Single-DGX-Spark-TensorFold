+    try partials(o, lt.t, .{ .plan = b.plan, .act = b.act, .sact = b.sact, .sids = b.sids, .ck4 = b.ck4, .shared_plan = if (rows <= state.max_rows) b.latentPlan(c, rows) else null }, b.pick, b.lat, b.y, rows, own, c, b.ymoe);

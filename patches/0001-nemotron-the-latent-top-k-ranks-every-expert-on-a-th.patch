-            score[ex] = m.sigmoid(logit);
-            const v = score[ex] + bias[ex];
-            sel[ex] = if (std.math.isNan(v)) -std.math.inf(f32) else v;
-        }
-        var total: f32 = 0;
-        var probs: [8]f32 = undefined;
-        var ids: [8]i32 = undefined;
-        for (0..top_k) |k| {
-            var bi: usize = 0;
-            for (1..e) |ex| if (sel[ex] > sel[bi]) {

+            for (int q = 0; q < 4; ++q) {
+                const float4 v = sel4[j / 4 + q];
+                const int i = j + 4 * q;
+                rank += beats(v.x, i, sel, e) + beats(v.y, i + 1, sel, e) + beats(v.z, i + 2, sel, e) +
+                        beats(v.w, i + 3, sel, e);

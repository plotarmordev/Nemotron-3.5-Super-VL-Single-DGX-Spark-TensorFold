+    const int numbers = __syncthreads_count(e < E && sel != -INFINITY);
+    if (e < E && sel != -INFINITY) {
+        const float4* sel4 = reinterpret_cast<const float4*>(sel_s);
+        int rank = 0;
+        for (int j = 0; j < blockDim.x && rank < TOPK; j += 16) {
 #pragma unroll
-        for (int off = 16; off > 0; off >>= 1) {

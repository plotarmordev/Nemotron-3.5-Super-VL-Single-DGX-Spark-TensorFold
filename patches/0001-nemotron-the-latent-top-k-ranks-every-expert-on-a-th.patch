-        p = __shfl_sync(0xffffffffu, p, bi % 32);
-        if (lane == k) mine = p, mine_id = bi;  // lane k keeps pick k
-        total = __fadd_rn(total, p);
+        if (rank < TOPK) pick_s[rank] = e, prob_s[rank] = score;
     }
-    if (lane >= TOPK) return;
+    if (e == 0)

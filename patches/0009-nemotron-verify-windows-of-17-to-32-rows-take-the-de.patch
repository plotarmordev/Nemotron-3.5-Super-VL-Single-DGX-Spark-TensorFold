From d75903467628a324919c741bc18041f5a6fad7b4 Mon Sep 17 00:00:00 2001
From: plotarmordev <299844489+plotarmordev@users.noreply.github.com>
Date: Sat, 17 Oct 2026 01:49:17 +0800
Subject: [PATCH 09/18] nemotron: verify windows of 17 to 32 rows take the
 decode-sized NVFP4 experts too

Ck chose the _few expert kernels for calls of up to launch.few_rows (16) token rows, the widest window when they came;
Super's windows now reach 32 rows, whose expert calls fell to the prompt kernels. Ck.few_tokens is 32: on a GB10 the
count prompt's window graph takes 121.7 ms at 17 rows (127.9 before), 137.2 at 24 (144.1) and 161.8 at 32 (168.7),
1 and 16 rows unchanged. Both kernels give a column the same steps in the same order; the modelopt test now checks 32
token rows byte-equal to the same pairs in a 40-row call as well.
---
 zig/src/cuda/ck.zig               |  7 +++++--
 zig/tests/cuda/modelopt_tests.zig | 12 ++++++------
 2 files changed, 11 insertions(+), 8 deletions(-)

diff --git a/zig/src/cuda/ck.zig b/zig/src/cuda/ck.zig
index 6ab3369d..889451d1 100644
--- a/zig/src/cuda/ck.zig
+++ b/zig/src/cuda/ck.zig
@@ -14,6 +14,9 @@ const Function = module.Function;
 const Stream = stream_.Stream;
 const Plan = grouped.Plan;
 
+/// Token rows an expert call takes as decode-sized (the _few kernels): a verify window's, up to 32.
+pub const few_tokens = 32;
+
 /// One fp32 factor: the checkpoint's runtimes multiply the input scale by the weight's in fp32.
 pub fn alpha(act: f32, scale: f32) f32 {
     return act * scale;
@@ -182,13 +185,13 @@ pub const Ck = struct {
 
     /// relu^2 up over a plan: NVFP4 rows (quant4's, at `rows`, `k` wide; row = pair / slots) to bf16 [pairs][width].
     pub fn up(c: *const Ck, s: Stream, l: Layer, rows: u64, nrows: usize, slots: usize, p: Plan, out: u64, items: usize) !void {
-        const few = @intFromBool(nrows <= launch_.few_rows);
+        const few = @intFromBool(nrows <= few_tokens);
         return run(s, c.up_fns[few], c.resident[few][0], warp_columns[few], rows, nrows, slots, l.up, l.up_s, l.up_alpha, l.dims, l.width, p, out, items);
     }
 
     /// down over a plan: NVFP4 pair rows (quant4's, at `rows`) of `tokens` token rows to fp32 [pairs][dims].
     pub fn down(c: *const Ck, s: Stream, l: Layer, rows: u64, nrows: usize, tokens: usize, p: Plan, out: u64, items: usize) !void {
-        const few = @intFromBool(tokens <= launch_.few_rows);
+        const few = @intFromBool(tokens <= few_tokens);
         return run(s, c.down_fns[few], c.resident[few][1], warp_columns[few], rows, nrows, 0, l.down, l.down_s, l.down_alpha, l.width, l.dims, p, out, items);
     }
 
diff --git a/zig/tests/cuda/modelopt_tests.zig b/zig/tests/cuda/modelopt_tests.zig
index 142945b0..b23266ab 100644
--- a/zig/tests/cuda/modelopt_tests.zig
+++ b/zig/tests/cuda/modelopt_tests.zig
@@ -348,8 +348,8 @@ fn experts(gpu: Gpu, rng: std.Random, p: *const modelopt.Packer, s: cuda.Stream)
     check.pass("nvfp4 relu^2 experts: rms error / rms(fp64) up {e:.3} (decode {e:.3}), down {e:.3} (decode {e:.3}); 13-row launch bytes == 40-row", .{ rel[1][0], rel[0][0], rel[1][1], rel[0][1] });
 }
 
-/// The checkpoint math's NVFP4 experts (cuda/ck.zig): each decode-sized call (1 and 16 token rows, ck_experts.cu's _few
-/// kernels) byte-equal to the same rows' pairs inside a 40-row call (the prompt kernels).
+/// The checkpoint math's NVFP4 experts (cuda/ck.zig): each decode-sized call (1, 16 and 32 token rows, ck_experts.cu's
+/// _few kernels) byte-equal to the same rows' pairs inside a 40-row call (the prompt kernels).
 fn checkpointExperts(gpu: Gpu, rng: std.Random, s: cuda.Stream, major: u32) !void {
     const a = gpu.gpa;
     const e = 6;
@@ -410,10 +410,10 @@ fn checkpointExperts(gpu: Gpu, rng: std.Random, s: cuda.Stream, major: u32) !voi
     defer aq.free();
     var y = try cuda.DeviceBuffer.alloc(gpu.d, pairs * dims * 4);
     defer y.free();
-    var outs: [3][2][]u8 = undefined; // 40 rows (prompt kernels), then 1 and 16 (decode-sized): act, y
+    var outs: [4][2][]u8 = undefined; // 40 rows (prompt kernels), then 1, 16 and 32 (decode-sized): act, y
     var got: usize = 0;
     defer for (outs[0..got]) |o| for (o) |b| a.free(b);
-    for ([3]usize{ rows, 1, 16 }) |nrows| {
+    for ([4]usize{ rows, 1, 16, 32 }) |nrows| {
         const np = nrows * slots;
         try router.route(s, dp.ptr, np, e, 16, plan);
         const items = cuda.grouped.maxItems(np, e, 16);
@@ -427,11 +427,11 @@ fn checkpointExperts(gpu: Gpu, rng: std.Random, s: cuda.Stream, major: u32) !voi
         outs[got] = .{ try check.download(gpu, act), try check.download(gpu, y) };
         got += 1;
     }
-    for (outs[1..], [2]usize{ 1, 16 }) |o, nrows| {
+    for (outs[1..], [3]usize{ 1, 16, 32 }) |o, nrows| {
         try check.sameBytes("checkpoint up, decode-sized against 40 rows", o[0][0 .. nrows * slots * width * 2], outs[0][0][0 .. nrows * slots * width * 2]);
         try check.sameBytes("checkpoint down, decode-sized against 40 rows", o[1][0 .. nrows * slots * dims * 4], outs[0][1][0 .. nrows * slots * dims * 4]);
     }
-    check.pass("checkpoint nvfp4 experts: 1 and 16 token rows (32 columns a warp, four steps in flight) byte-equal to the same pairs in a 40-row call (64 columns a warp)", .{});
+    check.pass("checkpoint nvfp4 experts: 1, 16 and 32 token rows (32 columns a warp, four steps in flight) byte-equal to the same pairs in a 40-row call (64 columns a warp)", .{});
 }
 
 /// Weight [r, c] of expert `x` of [n, k] NVFP4 matrices: e2m1 code times its e4m3 block scale.
-- 
